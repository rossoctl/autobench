# AutoBench install inputs — a template for `--env-file`.
#
# Read by reference/autobench-install.sh, reference/autobench-uninstall.sh, both bootstrap scripts
# (ocp-service-bootstrap.sh, kind-service-bootstrap.sh), kind-post-setup.sh and reference/preflight.py.
#
# USE IT LIKE THIS — outside the repo, never committed:
#
#   umask 077; mkdir -p ~/.rossoctl-<cluster>
#   cp reference/autobench.env.template ~/.rossoctl-<cluster>/autobench.env
#   chmod 600 ~/.rossoctl-<cluster>/autobench.env          # anything looser is refused
#   $EDITOR ~/.rossoctl-<cluster>/autobench.env
#   reference/autobench-install.sh --env-file ~/.rossoctl-<cluster>/autobench.env
#
# A filled copy holds credentials. `*.env` is gitignored, but keep it out of the working tree anyway.
#
# PRECEDENCE — the last one wins:
#   1. the shell environment you start the script from
#   2. each --env-file, in command-line order; within a file a later line beats an earlier one
#   3. explicit command-line flags
# So every value here can equally be exported in your shell instead, and a second, smaller file
# (e.g. a per-run override) can be layered on top: --env-file base.env --env-file override.env
# One exception: ~/.rossoctl-llm/profiles.env fills only names still UNSET, so anything set here
# beats it.
#
# GRAMMAR — smaller than a shell's on purpose:
#   KEY=value          everything after the first `=`, surrounding blanks trimmed
#   KEY="value"        one matching pair of quotes around the whole value is removed
#   export KEY=value   accepted, so the file can also be `source`d by hand
#   # comment          blank lines too
# Nothing is evaluated — no $VAR, no $(...), no escapes — so a password with `$` or a quote in it is
# stored exactly as written. `KEY=` is the empty string, which every required check reads as unset.
#
# So every value below is COMMENTED OUT (`#KEY=`): uncomment the ones you fill in. An uncommented
# `KEY=` is an assignment, and because a file beats the shell it would blank a value you exported.
#
# Hosts below are example.com placeholders: this repo is public, and so is the S3 bucket.

# --- where to install --------------------------------------------------------------------------------

# openshift | kind. Required by autobench-install.sh / autobench-uninstall.sh (or --platform).
#AB_PLATFORM=
# kubectl context of the cluster the Service runs on. Required (or --context).
#KUBE_CONTEXT=
# OpenShift: the cluster's short name, used to derive the apps/Keycloak hosts (ocp-service-bootstrap.sh
# --cluster), and the default S3_PREFIX "<cluster>/". KinD: the kind cluster name (default rossoctl).
#CLUSTER=
# Optional. The Service image tag; default is the chart's appVersion. Tags are immutable — an upgrade
# is a new tag, never a restart.
#IMAGE_TAG=
# Optional. Chart values file; default deploy/helm/values-<platform>.yaml.
#HELM_VALUES=

# --- the benchmarker identity ------------------------------------------------------------------------
# Every /deploy the Service makes is a ROPC login as this Keycloak user, so it is checked by a real
# login before anything is written.

# Default benchmarker — the user the bootstrap/seed scripts create. Change only if your realm differs.
KC_SERVICE_USERNAME=benchmarker
# REQUIRED: set exactly one of these two (a --password-file/--password-stdin flag beats both). The
# file form keeps the password out of this file: a chmod-600 file holding only the password.
#KC_SERVICE_PASSWORD=
#KC_SERVICE_PASSWORD_FILE=
# Optional — only if the Keycloak client is confidential.
#KC_SERVICE_CLIENT_SECRET=
# Optional — the master-realm admin password, which lets preflight.py ask the Admin API WHY a login
# fails (no password set vs wrong password). KinD reads it from the cluster when unset.
#KC_ADMIN_PASSWORD=

# --- the LLM gateway the workloads call --------------------------------------------------------------
# intranet | internet — which gateway, by NETWORK, never by platform. Selects the INTRANET_LLM_* or
# INTERNET_LLM_* set, from here or from ~/.rossoctl-llm/profiles.env.
#LLM_PROFILE=
# Optional overrides of the selected profile. The model must be an id THAT gateway lists in
# GET /v1/models, written WITH its client prefix, e.g. openai/<catalogue id>.
#WORKLOAD_LLM_API_BASE=
#WORKLOAD_LLM_MODEL=

# --- MLflow (ocp-service-bootstrap.sh) ---------------------------------------------------------------
# Optional; the defaults read the experiment id the collector actually writes to. Declare exactly one
# credential shape, or MLFLOW_NO_AUTH=1 — see `ocp-service-bootstrap.sh --help`.
#MLFLOW_URL=
#MLFLOW_EXPERIMENT_ID=
#MLFLOW_NO_AUTH=
#MLFLOW_BEARER_FILE=
# KinD only (autobench-install.sh / kind-mlflow.sh): auto (default) installs mlflow-reader and
# repoints the collector unless a Service already serves MLFLOW_URL; always installs and takes
# ownership; never touches nothing. autobench-uninstall.sh removes it only if the installer did.
#INSTALL_MLFLOW=auto

# --- S3 — where run artifacts are published ----------------------------------------------------------
# REQUIRED, and deliberately left unset: the install refuses to guess. Declare one of
#   S3_ENABLED=false   runs score but publish nothing; no s3 block is written
#   S3_ENABLED=true    every value below is required, and the key is proven with a signed read-only
#                      request (reference/s3check.py) before anything is installed
#S3_ENABLED=
# A DNS-style bucket name.
#S3_BUCKET=
# The bucket's region — a wrong one answers PermanentRedirect.
#S3_REGION=
# A writer key. PutObject alone is enough; the check accepts AccessDenied on list as "authenticated".
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Optional. Default "<cluster>/" on OpenShift, "kind/" on KinD. No leading slash.
#S3_PREFIX=
# Optional, S3-compatible stores only: a bare https://host[:port], no path.
#S3_ENDPOINT_URL=

# --- the IBAC judge — only for the plugin legs (#5-#8) -----------------------------------------------
# true installs the judge with the release (autobench-install.sh --ibac-judge does the same).
#IBAC_JUDGE=
# A chmod-600 file holding a key for the SAME LLM service the workloads call. It becomes the
# ibac-judge-upstream Secret.
#IBAC_JUDGE_KEY_FILE=
# A BASE url such as https://llm.example.com — the plugin appends /v1/chat/completions itself, so a
# path here is sent twice and 404s.
#IBAC_JUDGE_UPSTREAM_BASE=
# The bare catalogue id, e.g. Azure/gpt-4.1 — NO `openai/` prefix: unlike WORKLOAD_LLM_MODEL it is
# sent verbatim as the wire model. Use a non-reasoning model.
#IBAC_JUDGE_MODEL=

# --- autobench-cli (autobench-uninstall.sh tears workloads down through the Service) -----------------
# Optional: BM_BASE defaults to the Service's Route/HTTPRoute, BM_USER and BM_PASSWORD to the
# KC_SERVICE_* values above.
#BM_BASE=
#BM_ISS=
#BM_INSECURE=
